# Clarif-Eye environment template.
# Copy to .env and fill in. .env is gitignored; this file is committed.
# Never put real values in this file.

# --- Required: OpenRouter (LLM + VLM inference) -----------------------------
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Optional: OpenRouter attribution headers -------------------------------
# Sent as HTTP-Referer / X-Title. Improves rate-limit standing and shows the
# app on OpenRouter's leaderboard. Safe to leave blank.
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=Clarif-Eye

# Deployment note: the host (Render) supplies OPENROUTER_API_KEY as its own
# environment variable. This file is for local development only and is never
# deployed.
